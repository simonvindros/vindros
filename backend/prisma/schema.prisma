generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Instrument {
  id                  Int       @id
  name                String
  ticker              String
  isin                String?
  urlName             String?
  sectorId            Int?
  marketId            Int?
  branchId            Int?
  countryId           Int
  listingDate         DateTime?
  stockPriceCurrency  String?
  reportCurrency      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  stockPrices         StockPrice[]
  kpiValues           KpiValue[]

  technicalIndicator TechnicalIndicator[]
}

model StockPrice {
  id            Int        @id @default(autoincrement())
  instrumentId  Int
  date          DateTime
  open          Decimal
  high          Decimal
  low           Decimal
  close         Decimal
  volume        BigInt
  createdAt     DateTime   @default(now())

  instrument    Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, date])
}

model KpiMetadata {
  kpiId     Int     @id
  nameEn    String
  nameSv    String
  format    String?
  isString  Boolean

  kpiValues KpiValue[]
}

model KpiValue {
  id            Int         @id @default(autoincrement())
  instrumentId  Int
  kpiId         Int
  reportType    String
  priceType     String
  year          Int
  period        Int         @default(0)
  value         Decimal?
  createdAt     DateTime    @default(now())

  instrument    Instrument  @relation(fields: [instrumentId], references: [id])
  kpi           KpiMetadata @relation(fields: [kpiId], references: [kpiId])

  @@unique([instrumentId, kpiId, reportType, priceType, year, period])
}

model Market {
  marketId      Int      @id
  name          String
  countryId     Int
  isIndex       Boolean
  exchangeName  String?
}

model Sector {
  sectorId  Int     @id
  name      String
}

model Country {
  countryId  Int     @id
  name       String
}

model Branch {
  branchId  Int     @id
  name      String
  sectorId  Int
}

model TechnicalIndicator {
  id Int @id @default(autoincrement())
  instrumentId Int
  date DateTime
  type String
  value Decimal
  createdAt DateTime @default(now())
  
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([instrumentId, date, type])
}

model StockSplit {
  id            Int      @id @default(autoincrement())
  instrumentId  Int
  splitType     String   // S = split, RS = reverse split, F = fondemission, N = nyemission, D = delning
  ratio         String   // Raw ratio string from API (e.g. "3:1", "1:10")
  splitDate     DateTime
  ratioFactor   Decimal  // Computed: price multiplier for pre-split prices (e.g. RS 1:10 → 10.0, S 3:1 → 0.333)
  applied       Boolean  @default(false) // Whether this split has been applied to StockPrice data
  createdAt     DateTime @default(now())

  @@unique([instrumentId, splitDate])
}