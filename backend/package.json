{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "docker:up": "open -a Docker && until docker info > /dev/null 2>&1; do sleep 1; done && docker-compose -f ../docker-compose.yml up -d",
    "docker:down": "docker-compose -f ../docker-compose.yml down",
    "prisma:studio": "prisma studio --port 5556",
    "prisma:migrate": "prisma migrate dev",
    "setup": "npm run docker:up && wait-on tcp:5432 && npm run prisma:migrate",
    "start:all": "concurrently \"npm run dev\" \"npm run prisma:studio\"",
    "seed": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/seed/main.ts",
    "clear:prices": "ts-node src/scripts/clear.ts",
    "update": "npm run update:instruments && npm run update:prices && npm run update:kpis && npm run vindros:dynamic",
    "update:instruments": "ts-node src/scripts/updateInstruments.ts",
    "update:prices": "ts-node src/scripts/updatePrices.ts",
    "update:kpis": "ts-node src/scripts/updateKpis.ts",
    "compute:indicators": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/scripts/computeIndicators.ts",
    "vindros": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/scripts/vindros.ts",
    "vindros:dynamic": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/scripts/vindrosDynamicSignals.ts",
    "seed:global": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/seed/seedGlobal.ts",
    "seed:kpis": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/seed/seedKpiValuesGlobal.ts",
    "montecarlo": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/backtest/montecarlo.ts",
    "montecarlo:60": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/backtest/montecarlo.ts --reg=60",
    "montecarlo:dayshift": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' ts-node src/backtest/montecarlo_dayshift.ts",
    "montecarlo:dayshift-full": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/backtest/montecarlo_dayshift_full.ts",
    "montecarlo:dayshift-full:60": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/backtest/montecarlo_dayshift_full.ts --reg=60",
    "sweep": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/backtest/parameter_sweep.ts",
    "attribution": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/backtest/stock_attribution.ts",
    "race": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/backtest/race_to_1m.ts",
    "dynamic": "TS_NODE_COMPILER_OPTIONS='{\"rootDir\":\".\"}' cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node src/backtest/vindros_dynamic.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@apollo/server": "^5.5.0",
    "@as-integrations/express5": "^1.1.2",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.5.0",
    "axios": "^1.14.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "graphql": "^16.13.2",
    "graphql-depth-limit": "^1.1.0",
    "prisma": "^7.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "wait-on": "^9.0.4"
  }
}
